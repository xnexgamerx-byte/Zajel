# خادم الويب. شهادة HTTPS لكل نطاقٍ تُصدَر وحدها عند أول زيارةٍ له
# (on-demand TLS)، بعد أن يؤكّد التطبيق أنّ النطاق لشركةٍ مسجّلة —
# فشركةٌ تُسجَّل اليوم يعمل نطاقها بـ HTTPS بلا أيّ إعداد.

{
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://127.0.0.1:8081/_tls/allowed
	}

	{$CADDY_GLOBAL_OPTIONS}
}

# كل نطاقٍ يصل الخادم
https:// {
	tls {
		on_demand
	}

	root * /var/www/html/public
	encode zstd gzip

	# لوحة المنصّة على admin وحده: لا نموذج دخولٍ لها على نطاق كل شركة
	@platformElsewhere {
		path /admin /admin/*
		not host admin.{$DOMAIN}
	}
	respond @platformElsewhere 404

	# ملفات Vite تحمل بصمتها في اسمها: تُخزَّن سنةً في المتصفّح
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000
	file_server
}

# سؤال الشهادات: داخليّ، لا يصله أحدٌ من خارج الخادم
http://127.0.0.1:8081 {
	bind 127.0.0.1
	root * /var/www/html/public
	php_fastcgi app:9000
}
