# خادم الويب خلف Cloudflare (السحابة البرتقالية). يختاره setup.sh بـ
# CADDYFILE=Caddyfile.cloudflare في .env، ومكانه Caddyfile للخادم المكشوف.
#
# الشهادة شهادة Cloudflare للمصدر (Origin CA) في certs/: للنطاق وكل نطاقاته
# الفرعية معاً، فلا يُطلب من Let's Encrypt شيء — ولا يستطيع: التحقّق منه يصل
# Cloudflare لا هذا الخادم. وشركةٌ تُسجَّل اليوم يعمل نطاقها فوراً بالشهادة نفسها.

{
	servers {
		# كل زائرٍ يصل من Cloudflare، وعنوانه الحقيقيّ في X-Forwarded-For. يُصدَّق
		# الرأس من عناوينها وحدها (cloudflare-ranges.sh يكتبها في .env)، ويُؤخذ منه
		# أقرب عنوانٍ غريب إليها لا أوّله: ما في أوّله يكتبه الزائر بنفسه
		trusted_proxies static {$CLOUDFLARE_RANGES}
		trusted_proxies_strict
	}
}

{$DOMAIN}, *.{$DOMAIN} {
	tls /certs/origin.pem /certs/origin.key

	root * /var/www/html/public
	encode zstd gzip

	# لوحة المنصّة على admin وحده: لا نموذج دخولٍ لها على نطاق كل شركة
	@platformElsewhere {
		path /admin /admin/*
		not host admin.{$DOMAIN}
	}
	respond @platformElsewhere 404

	# ملفات Vite تحمل بصمتها في اسمها: تُخزَّن سنةً في المتصفّح وفي Cloudflare
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000
	file_server
}
