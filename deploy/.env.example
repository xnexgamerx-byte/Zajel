# ── يكتبه setup.sh؛ ولمن يعدّه يدوياً: انسخه إلى .env واملأه ──

# النطاق الأساسي. كل شركةٍ نطاقٌ فرعيّ منه، ولوحة المنصّة على admin.
DOMAIN=zajel.iq

# بريدٌ تراسلك عليه Let's Encrypt إن تعثّر تجديد شهادة
ACME_EMAIL=you@example.com

# أسرار: تُولَّد عشوائياً، ولا تُغيَّر بعد التشغيل الأول
# (مفتاح التطبيق يوقّع الجلسات وروابط التتبّع المطبوعة على الوصولات)
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ذاكرة قاعدة البيانات: نحو ربع ذاكرة الخادم
DB_BUFFER_POOL=1G

# النسخ الاحتياطي (backup.sh)
BACKUP_DIR=/var/backups/zajel
BACKUP_KEEP_DAYS=14
# نسخةٌ خارج الخادم عبر rclone، مثل: gdrive:zajel-backups (فارغ = بلا نسخةٍ خارجية)
BACKUP_REMOTE=
