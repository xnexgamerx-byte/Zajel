# Railway: HTTPS وشهادات النطاقات عند Railway، وهنا HTTP على المنفذ الذي يعطيه.
{
	admin off
	auto_https off

	# لا يصل الحاويةَ أحدٌ إلا عبر وكيل Railway: فما يقوله عن الزائر
	# (X-Forwarded-For وProto) يمرّ إلى PHP كما هو. وبغير هذا يستبدل Caddy
	# الرأس بعنوان الوكيل، فيبدو كل الزوّار عنواناً واحداً ويُقفَل الدخول
	# على الجميع معاً.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	root * /var/www/html/public
	encode zstd gzip

	# لوحة المنصّة على admin وحده: لا نموذج دخولٍ لها على نطاق كل شركة
	@platformElsewhere {
		path /admin /admin/*
		not host admin.{$ZAJEL_TENANT_DOMAIN}
	}
	respond @platformElsewhere 404

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi 127.0.0.1:9000
	file_server
}
